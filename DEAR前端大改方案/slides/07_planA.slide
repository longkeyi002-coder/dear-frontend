      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E2B24' }}>手机底部 Tab：最稳的那一版</Text>
    </Box>

    <Box style={{ height: 540, padding: '16px 72px', flexDirection: 'row', gap: 48, alignItems: 'center' }}>
      <Box style={{ width: 300, alignItems: 'center' }}>
        <svg width={240} height={470} viewBox='0 0 260 500'>
          <rect x='10' y='10' width='240' height='480' rx='34' fill='#E3EFE8' stroke='#CFE0D6' strokeWidth='2' />
          <rect x='22' y='26' width='216' height='420' rx='20' fill='#F5F9F6' />
          <rect x='40' y='70' width='130' height='44' rx='14' fill='#E3EFE8' />
          <rect x='108' y='132' width='118' height='40' rx='14' fill='#2E9E6F' opacity='0.18' />
          <rect x='40' y='190' width='140' height='44' rx='14' fill='#E3EFE8' />
          <rect x='40' y='406' width='180' height='34' rx='17' fill='#FFFFFF' stroke='#CFE0D6' strokeWidth='2' />
          <rect x='22' y='452' width='216' height='46' rx='16' fill='#FFFFFF' stroke='#CFE0D6' strokeWidth='2' />
          <rect x='36' y='462' width='30' height='26' rx='8' fill='#2E9E6F' />
          <rect x='80' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
          <rect x='120' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
          <rect x='160' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
          <rect x='198' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
