<Slide style={{ width: '1280px', height: '720px', background: '#F5F9F6' }}>
  <Box style={{ height: '100%', flexDirection: 'column' }}>
    <Box style={{ height: 110, padding: '26px 72px 0', justifyContent: 'flex-end' }}>
      <Text style={{ fontSize: 14, color: '#2E9E6F', fontWeight: '600', letterSpacing: 1 }}>方案 C</Text>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E2B24' }}>桌面侧栏 + 手机底部：双形态</Text>
    </Box>

    <Box style={{ height: 540, padding: '14px 72px', flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
      <Text style={{ fontSize: 19, color: '#1E2B24', lineHeight: 1.6, textAlign: 'center' }}>
        电脑上<span style={{ color: '#2E9E6F', fontWeight: 'bold' }}>左侧一排导航</span>，手机上<span style={{ color: '#2E9E6F', fontWeight: 'bold' }}>底部一排 Tab</span>——同一套功能，两种摆法。
      </Text>

      <Box style={{ flexDirection: 'row', gap: 40, alignItems: 'center', justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 10 }}>
          <svg width={540} height={330} viewBox='0 0 600 370'>
            <rect x='10' y='10' width='580' height='350' rx='18' fill='#F5F9F6' stroke='#CFE0D6' strokeWidth='2' />
            <rect x='10' y='10' width='118' height='350' rx='18' fill='#E3EFE8' />
            <rect x='26' y='30' width='86' height='26' rx='8' fill='#2E9E6F' />
            <rect x='26' y='66' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='100' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='134' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='168' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='202' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='236' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='270' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='26' y='304' width='86' height='22' rx='7' fill='#CFE0D6' />
            <rect x='160' y='48' width='200' height='40' rx='12' fill='#E3EFE8' />
            <rect x='300' y='108' width='180' height='36' rx='12' fill='#2E9E6F' opacity='0.18' />
            <rect x='160' y='168' width='220' height='40' rx='12' fill='#E3EFE8' />
            <rect x='160' y='310' width='390' height='32' rx='16' fill='#FFFFFF' stroke='#CFE0D6' strokeWidth='2' />
          </svg>
          <Text style={{ fontSize: 16, color: '#5E6E66' }}>电脑端：左侧常驻导航栏</Text>
        </Box>

        <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 10 }}>
          <svg width={190} height={370} viewBox='0 0 260 500'>
            <rect x='10' y='10' width='240' height='480' rx='34' fill='#E3EFE8' stroke='#CFE0D6' strokeWidth='2' />
            <rect x='22' y='26' width='216' height='420' rx='20' fill='#F5F9F6' />
            <rect x='40' y='70' width='130' height='40' rx='14' fill='#E3EFE8' />
            <rect x='108' y='128' width='110' height='36' rx='14' fill='#2E9E6F' opacity='0.18' />
            <rect x='22' y='452' width='216' height='46' rx='16' fill='#FFFFFF' stroke='#CFE0D6' strokeWidth='2' />
            <rect x='36' y='462' width='30' height='26' rx='8' fill='#2E9E6F' />
            <rect x='80' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
            <rect x='120' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
            <rect x='160' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
            <rect x='198' y='464' width='26' height='22' rx='7' fill='#CFE0D6' />
          </svg>
          <Text style={{ fontSize: 16, color: '#5E6E66' }}>手机端：底部 Tab</Text>
        </Box>
      </Box>

      <Box style={{ flexDirection: 'row', gap: 12, justifyContent: 'center', marginTop: 4 }}>
        <Text style={{ fontSize: 17, color: '#5E6E66' }}>最完整，但也要做两套适配——</Text>
        <Text style={{ fontSize: 17, color: '#2E9E6F', fontWeight: 'bold' }}>最重，适合常坐电脑前的你。</Text>
      </Box>
    </Box>

    <Box style={{ height: 60, padding: '0 72px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
      <Text style={{ fontSize: 14, color: '#5E6E66' }}>DEAR 功能页布局方案</Text>
      <Text style={{ fontSize: 14, color: '#5E6E66' }}>09 / 11</Text>
    </Box>
  </Box>
</Slide>
